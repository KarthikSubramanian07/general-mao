# Copy to `.env` (or `.env.production`) to point the client at a deployed API.
# In local dev both default to the wrangler worker on http://localhost:8787.

# The deployed Worker origin (protocol + host, no trailing slash):
# VITE_API_BASE=https://general-mao-api.<your-subdomain>.workers.dev

# Optional: WebSocket host override (defaults to VITE_API_BASE's host).
# VITE_WS_HOST=general-mao-api.<your-subdomain>.workers.dev
